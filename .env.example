# ============ Application ============
# prod | dev | test. В prod кэшируется metadata Doctrine, скрываются тексты 500-х ошибок.
APP_ENV=prod
# 1 — показывать текст исключений в 500-х ответах (только для разработки)
APP_DEBUG=0

# ============ HTTP ============
# Порт, на котором nginx отдаёт фронтенд и API (http://localhost:8080)
HTTP_PORT=8080
# Порт web-интерфейса RabbitMQ (guest/guest)
RABBITMQ_UI_PORT=15672

# ============ Database (MySQL 8) ============
DB_DRIVER=pdo_mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

# ============ Queue (Symfony Messenger) ============
# RabbitMQ: amqp://user:pass@host:port/vhost/queue
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

# ============ Auth (JWT) ============
# Секрет для подписи HS256, минимум 32 символа. ОБЯЗАТЕЛЬНО сменить вне локальной разработки.
JWT_SECRET=change-me-change-me-change-me-32chars
# Время жизни токена, секунд
JWT_TTL=3600
# Единственный пользователь системы (для тестового задания)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ============ Import ============
# Максимальный размер xlsx, байт (10 МБ)
IMPORT_MAX_BYTES=10485760
# Максимальный размер одного скачиваемого изображения, байт (5 МБ)
IMAGE_MAX_BYTES=5242880
# Rate limit на POST /api/imports: N запросов на пользователя за интервал
IMPORT_RATE_LIMIT=5
IMPORT_RATE_INTERVAL=1 minute
# Каталоги внутри контейнера (смонтированы как volumes)
IMPORT_DIR=/var/www/html/storage/imports
IMAGE_DIR=/var/www/html/storage/images
# Публичный URL-префикс изображений (отдаёт nginx)
IMAGE_PUBLIC_URL=/uploads
