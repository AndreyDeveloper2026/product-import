{
    "name": "test/product-import",
    "description": "Product import/export: Slim + Doctrine + Messenger",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-zip": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "symfony/messenger": "^7.2",
        "symfony/amqp-messenger": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/finder": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "symfony/cache": "^7.2",
        "openspout/openspout": "^4.28",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^3.8",
        "zircote/swagger-php": "^5.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.0",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
